# Copy to .env and fill in. Every process parses these with Zod at boot
# (packages/shared/src/env) and exits non-zero if any required value is
# missing or malformed. No real secrets belong in this file.

# Postgres connection string. Local dev uses the docker-compose database
# (`docker compose up -d`); deployed environments point this at Supabase or
# Neon. Used by: api, worker, web.
DATABASE_URL=postgres://ordersync:ordersync@localhost:5433/ordersync

# Separate database the schema integration test runs against, so a test run
# never truncates dev data. Created by docker-compose. Used by: tests.
TEST_DATABASE_URL=postgres://ordersync:ordersync@localhost:5433/ordersync_test

# Shared secret Shopify signs webhook bodies with (HMAC-SHA256). Used by: api.
SHOPIFY_WEBHOOK_SECRET=replace-with-shopify-webhook-signing-secret

# Base URL of the Shopify Admin API, e.g. https://your-shop.myshopify.com. Used by: worker.
SHOPIFY_API_BASE_URL=https://your-shop.myshopify.com

# Intuit app client id. Used by: worker.
QUICKBOOKS_CLIENT_ID=replace-with-intuit-client-id

# Intuit app client secret. Used by: worker.
QUICKBOOKS_CLIENT_SECRET=replace-with-intuit-client-secret

# QuickBooks Online API base URL (sandbox or production). Used by: worker.
QUICKBOOKS_API_BASE_URL=https://sandbox-quickbooks.api.intuit.com

# Symmetric key used to encrypt connection tokens at rest. Minimum 32 characters. Used by: worker.
TOKEN_ENCRYPTION_KEY=replace-with-a-random-string-at-least-32-chars

# The single hardcoded operator login for the dashboard. Used by: api, web.
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=replace-with-operator-password

# Port the Fastify API listens on. Optional, defaults to 3001. Used by: api.
PORT=3001
